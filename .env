# ==== Telegram API Credentials (required, apply at my.telegram.org) ====
API_ID=1234567
API_HASH=your_api_hash_here

# ==== Bot Token (get from @BotFather) ====
BOT_TOKEN=your_bot_token_here

# ==== Owner Info (optional) ====
OWNER_NAME=YourName

# ==== Session Storage Directory ====
SESSION_DIR=sessions
